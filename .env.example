# Application Configuration
APP_NAME=Web Profile
APP_ENV=development
APP_PORT=8080
APP_DEBUG=true
# Public URL of the frontend (used in password reset links and the verify page)
APP_FRONTEND_URL=http://localhost:3000
# Public URL of this API including /api (used in email verification links)
APP_BACKEND_URL=http://localhost:8080/api

# Database Configuration (Go reads DB_*, Prisma reads DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=web_profile_db
DB_SSL_MODE=disable
DB_TIMEZONE=Asia/Jakarta
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/web_profile_db?schema=public

# Redis Configuration
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRED_HOUR=24
JWT_REFRESH_EXPIRED_HOUR=168

# Auth cookies. In production behind HTTPS use COOKIE_SECURE=true; when the
# frontend lives on another site use COOKIE_SAME_SITE=none (requires Secure).
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# CORS Configuration (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Logger Configuration
# console = human readable + coloured levels; json = Loki/Promtail friendly.
# Leave empty to auto-detect: console on a terminal, JSON when piped or in a container.
LOG_FORMAT=
LOG_TO_FILE=false
LOG_FILE_PATH=logs/app.log
LOG_MAX_SIZE=100
LOG_MAX_BACKUPS=3
LOG_MAX_AGE=28
LOG_COMPRESS=true

# SMTP Configuration (Email Service)
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM_NAME=Web Profile
SMTP_FROM_EMAIL=noreply@example.com

# Seeder (go run main.go -seed)
SEED_SUPERADMIN_NAME=Super Admin
SEED_SUPERADMIN_EMAIL=admin@example.com
SEED_SUPERADMIN_PASSWORD=ChangeMe123!
